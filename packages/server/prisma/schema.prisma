// VaultKeep sync server schema.
// CRITICAL: every column that could hold a secret stores CIPHERTEXT only.
// The server is zero-knowledge — it can route and version blobs, never read them.
// Connection URL lives in prisma.config.ts (Prisma 7), read from DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  // Argon2 params + salt so any device can re-derive the master key.
  kdfSalt       String
  kdfMemoryKiB  Int           @default(262144)
  kdfIterations Int           @default(4)
  kdfParallel   Int           @default(4)
  // Argon2 hash of the client-derived auth verifier (NOT the master password).
  authHash      String
  createdAt     DateTime      @default(now())
  devices       Device[]
  vaultItems    VaultItem[]
  mfaMethods    MfaMethod[]
  passkeys      PasskeyCredential[]
  recoveryKey   RecoveryKey?
  emergencyContacts EmergencyContact[]
  auditLogs     AuditLog[]
}

model Device {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  name             String
  platform         String
  publicKey        String // X25519, base64
  signingPublicKey String // Ed25519, base64
  approved         Boolean  @default(false)
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
}

model VaultItem {
  // Item ids are client-generated and only unique PER USER — the composite key
  // makes cross-tenant overwrites impossible at the database level.
  id         String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  ciphertext String // base64(nonce||ct||tag) — opaque to the server
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@id([userId, id])
  @@index([userId, updatedAt])
}

model MfaMethod {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  kind      String // "totp" | "webauthn" | "sms"
  // TOTP secret must be server-verifiable (encrypt at rest with a KMS key in prod).
  secret    String
  label     String  @default("")
  // Two-phase enrollment: pending until the user proves possession with a code.
  confirmed Boolean @default(false)

  @@unique([userId, kind])
}

model PasskeyCredential {
  // WebAuthn credential id (base64url) — chosen by the authenticator.
  credentialId String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  // Public key as JSON-encoded JWK; -7 ES256 | -8 EdDSA | -257 RS256.
  publicKeyJwk String
  alg          Int
  signCount    Int      @default(0)
  name         String   @default("Passkey")
  createdAt    DateTime @default(now())

  @@index([userId])
}

model RecoveryKey {
  // One recovery configuration per user (rotating replaces it).
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id])
  // Argon2 hash of the recovery AUTH VERIFIER (client-derived; the wrap half
  // of the recovery key never reaches the server).
  verifierHash String
  // Master key wrapped under the client-only wrap key — opaque ciphertext.
  wrappedKey   String
  createdAt    DateTime @default(now())
}

model EmergencyContact {
  id                      String    @id @default(uuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id])
  contactEmail            String
  // Contact's Ed25519 public key — authenticates their signed requests.
  contactSigningPublicKey String
  // Master key SEALED to the contact's X25519 key (ephemeral ECDH) —
  // the server stores and times the release; it can never open it.
  ephemeralPublicKey      String
  wrappedKey              String
  state                   String    @default("enrolled") // enrolled|pending|denied|released
  unlockAt                DateTime?
  createdAt               DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  deviceId  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
